# Copy to .env and fill in. .env is git-ignored.

# Shared HMAC key configured on the TFC run task (used to verify request signatures).
TFI_TFC_HMAC_KEY=replace-me

# TFC team token (scoped to read workspace) for fetching plan JSON and ingress-attributes.
TFI_TFC_TEAM_TOKEN=replace-me

# TFC API base URL (default: https://app.terraform.io/api/v2, override for enterprise).
# TFI_TFC_API_BASE_URL=https://app.terraform.io/api/v2
