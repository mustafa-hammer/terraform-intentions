# Copy to .env and fill in. .env is git-ignored.
# Shared HMAC key configured on the TFC run task (used to verify request signatures).
TFI_TFC_HMAC_KEY=replace-me

# TFC team token used to fetch plan JSON and ingress-attributes (PR body, PR number).
# Create at: Organization Settings → Teams → <your team> → Team API Token
# Needs read access to the workspace's configuration versions and plans.
TFI_TFC_TEAM_TOKEN=replace-me

# OpenAI API key for the LangChain verdict chain.
TFI_OPENAI_API_KEY=sk-...

# Chat model to use (default: gpt-4o-mini).  Override for gpt-4o or other OpenAI models.
# TFI_OPENAI_MODEL=gpt-4o-mini
